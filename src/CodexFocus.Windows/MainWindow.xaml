<Window x:Class="CodexFocus.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Focus Windows"
        Width="920"
        Height="640"
        MinWidth="780"
        MinHeight="540"
        Icon="Assets/AppIcon.ico"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="92"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,4,16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,18,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="1" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="开始监听" Command="{Binding StartCommand}"/>
                    <Button Content="停止监听" Command="{Binding StopCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Codex Focus Windows" FontSize="22" FontWeight="SemiBold" Foreground="#1F2937"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" FontSize="15" Foreground="#2563EB"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="1" Padding="14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Codex 窗口" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="{Binding CodexWindowText}" Margin="0,8,0,0" Foreground="#4B5563"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="1" Padding="14" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="抖音窗口" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="{Binding DouyinWindowText}" Margin="0,8,0,0" Foreground="#4B5563"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="轮询间隔（秒）" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="启动后自动监听" IsChecked="{Binding AutoStartMonitoring}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="切换延迟（秒，0=立即）" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TaskSwitchDelaySeconds, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="抖音关键词" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DouyinKeywordsText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Codex 关键词" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CodexKeywordsText, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Row="3" Grid.Column="2" Content="开机自启" IsChecked="{Binding StartWithWindows}"/>
                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"/>
                    <Button Content="刷新窗口" Command="{Binding RefreshWindowsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="测试切到抖音" Command="{Binding TestDouyinCommand}"/>
                <Button Content="测试切回 Codex" Command="{Binding TestCodexCommand}"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9E0EA" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="最近事件" Padding="14,12" FontWeight="SemiBold" Foreground="#111827"/>
                    <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Padding="8" FontFamily="Consolas"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
